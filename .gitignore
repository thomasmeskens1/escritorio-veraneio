# ===== Python / backend =====
__pycache__/
*.py[cod]
.venv/
venv/
.env
# Variantes do .env (.env.local, .env.prod...). O .env.example também fica fora até alguém conferir que ele tem
# só nomes de variáveis, sem valores reais (o repositório é público).
.env.*
.pytest_cache/
backend/dados/
# Credenciais soltas em qualquer pasta (tokens OAuth, chaves privadas, padrões privados do verificador de segredos)
*.token.json
*.pem
padroes_segredos.txt

# ===== Node / ferramentas =====
node_modules/
npm-debug.log*

# ===== Sistema / editor =====
.DS_Store
Thumbs.db
.vscode/
.idea/

# ===== Claude Code =====
.claude/settings.local.json
.claude/settings.json.bak*

# ===== Ruflo (MCP) =====
# Versionados (necessários para o MCP e os hooks funcionarem num clone novo):
#   .mcp.json, .claude/settings.json, .claude/helpers/,
#   .claude-flow/config.yaml, CLAUDE.md

# Memória e estado de execução
.swarm/
.claude/proven-config.json
.claude/.proven-config-version
.hive-mind/
.claude-flow/*
!.claude-flow/config.yaml
# Estado do Ruflo criado em subpastas (ex.: backend/.claude-flow/sessions, com trechos de conversa e caminhos)
/*/**/.claude-flow/
/*/**/.swarm/
/*/**/.hive-mind/

# Conteúdo genérico gerado pelo `npx ruflo@latest init` (recriável)
.claude/agents/
.claude/commands/
.claude/skills/
.agents/

# Arquivos de banco/log gerados em qualquer lugar
*.db
*.db-journal
*.db-wal
*.db-shm
*.log

# Worktrees temporários dos agentes do Claude Code
.claude/worktrees/

# Cloudflare Worker (cache local do wrangler)
deploy/worker/.wrangler/
deploy/worker/node_modules/
